  "children": [
    {
      "type": "Text",
      "properties": {
        "text": "agent-vm keeps these records as files on this Mac, where nothing in a box can change them. The app shows the last of each.",
        "frame": {
          "maxWidth": "infinity",
          "alignment": "leading"
        }
      }
    },
    {
      "type": "VStack",
      "properties": {
        "alignment": "leading",
        "spacing": 4
      },
      "children": [
        {
          "type": "HStack",
          "properties": {
            "spacing": 8
          },
          "children": [
            {
              "type": "Text",
              "properties": {
                "text": "In a box's folder",
                "font": "headline",
                "frame": {
                  "maxWidth": "infinity",
                  "alignment": "leading"
                }
              }
            },
            {
              "type": "Button",
              "id": 4321,
              "properties": {
                "title": "Show in Finder",
                "controlSize": "small",
                "disabled": true,
                "actionID": "AgentVM.logs.show",
                "help": "Open this folder in Finder."
              }
            },
            {
              "type": "Button",
              "id": 4331,
              "properties": {
                "title": "Copy Path",
                "controlSize": "small",
                "actionID": "AgentVM.logs.path",
                "help": "Copy the full path of this folder."
              }
            }
          ]
        },
        {
          "type": "Text",
          "properties": {
            "text": "What ran in the box: exec.jsonl, each program agent-vm started in it and how it ended.",
            "frame": {
              "maxWidth": "infinity",
              "alignment": "leading"
            }
          }
        },
        {
          "type": "Text",
          "properties": {
            "text": "What it contacted, and what was refused: network-allowed.jsonl and network.jsonl.",
            "frame": {
              "maxWidth": "infinity",
              "alignment": "leading"
            }
          }
        },
        {
          "type": "Text",
          "properties": {
            "text": "Why it did not start, or stopped: supervisor.log, and console.log for a Linux box.",
            "frame": {
              "maxWidth": "infinity",
              "alignment": "leading"
            }
          }
        },
        {
          "type": "Text",
