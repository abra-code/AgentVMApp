{
  "type": "VStack",
  "properties": {
    "alignment": "leading",
    "spacing": 12,
    "padding": 20,
    "frame": {
      "minWidth": 480,
      "idealWidth": 540,
      "minHeight": 240
    }
  },
  "children": [
    {
      "type": "Text",
      "properties": {
        "text": "Discard the ended sessions of every project",
        "font": "headline"
      }
    },
    {
      "type": "Text",
      "properties": {
        "text": "Discarded sessions can no longer be undone. Active sessions are never discarded.",
        "foregroundStyle": "secondary",
        "frame": {
          "maxWidth": "infinity",
          "alignment": "leading"
        }
      }
    },
    {
      "type": "HStack",
      "properties": {
        "alignment": "top",
        "spacing": 8
      },
      "children": [
        {
          "type": "Picker",
          "id": 5402,
          "properties": {
            "title": "Which sessions",
            "labelsHidden": true,
            "pickerStyle": "radioGroup",
            "options": [
              {
                "title": "Those that ended before",
                "tag": "before"
              },
              {
                "title": "All ended and undone sessions",
                "tag": "all"
              }
            ],
            "actionID": "AgentVM.discard.choice"
          }
        },
        {
          "type": "DatePicker",
          "id": 5403,
          "properties": {
            "title": "Ended before",
            "displayStyle": "stepperField",
            "displayedComponents": "date",
            "valueChangeActionID": "AgentVM.discard.date",
            "help": "Discard sessions that ended before this day",
            "labelsHidden": true
          }
        }
      ]
    },
    {
      "type": "Text",
      "id": 5404,
      "properties": {
        "text": "",
        "textSelection": "enabled",
        "frame": {
          "maxWidth": "infinity",
          "alignment": "leading"
        }
      }
    },
    {
      "type": "Spacer",
      "properties": {
        "minLength": 0
      }
    },
    {
      "type": "HStack",
      "properties": {
        "spacing": 8
      },
      "children": [
        {
          "type": "Spacer"
        },
        {
          "type": "Button",
          "id": 5405,
          "properties": {
            "title": "Cancel",
            "role": "cancel",
            "actionID": "AgentVM.discard.cancel"
          }
        },
        {
          "type": "Button",
          "id": 5406,
          "properties": {
            "title": "Discard",
            "role": "destructive",
            "buttonStyle": "borderedProminent",
            "disabled": true,
            "actionID": "AgentVM.discard.go",
            "help": "Discard the sessions chosen above"
          }
        }
      ]
    }
  ]
}
